  "dialog": [
    {
      "speaker": "L",
      "text": "Buenas tardes. ¿En qué le puedo ayudar?",
      "translation": "Good afternoon. How can I help you?",
      "grammar_tags": [
        "es.a1.usted"
      ]
    },
    {
      "speaker": "A",
      "text": "Buenas tardes. Necesito arreglar mi bicicleta.",
      "translation": "Good afternoon. I need to fix my bike.",
      "grammar_tags": [
        "es.a1.necesitar_inf"
      ]
    },
    {
      "speaker": "L",
      "text": "¿Qué le pasa?",
      "translation": "What's wrong with it?",
      "grammar_tags": []
    },
    {
      "speaker": "A",
      "text": "Tiene una llanta ponchada.",
      "translation": "It has a flat tire.",
      "grammar_tags": []
    },
    {
      "speaker": "L",
      "text": "Muy bien. ¿Para cuándo la necesita?",
      "translation": "All right. When do you need it by?",
      "grammar_tags": [
        "es.a1.usted"
      ]
    },
    {
      "speaker": "A",
      "text": "Para mañana, por favor. ¿Cuánto cuesta?",
      "translation": "By tomorrow, please. How much does it cost?",
      "grammar_tags": [
        "es.a1.cuanto_cuesta"
      ]
    },
    {
      "speaker": "L",
      "text": "Son cien pesos.",
      "translation": "It's a hundred pesos.",
      "grammar_tags": []
    },
    {
      "speaker": "A",
      "text": "Perfecto. Muchas gracias.",
      "translation": "Perfect. Thank you very much.",
      "grammar_tags": []
    }
  ],
